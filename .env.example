# PurpleAir API anahtarı — develop.purpleair.com adresinden ücretsiz alın
PURPLEAIR_API_KEY=your_key_here

# Sensör ID (GTÜ #229263, değiştirmeyin)
PURPLEAIR_SENSOR_ID=229263

# Veritabanı — boş bırakırsanız SQLite kullanılır (yerel geliştirme için ideal)
# PostgreSQL için: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# SQLite dosya yolu (DATABASE_URL boş olduğunda kullanılır)
SQLITE_PATH=campus_air.db

# Admin işlemleri için token (DELETE /api/sessions vb.)
ADMIN_TOKEN=changeme_please

# Polling aralığı (dakika)
POLL_INTERVAL_MINUTES=2

# CORS — frontend URL'si (üretimde GitHub Pages URL'nizi girin)
CORS_ORIGINS=*

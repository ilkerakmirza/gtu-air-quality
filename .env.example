# PurpleAir API anahtarı — develop.purpleair.com adresinden ücretsiz alın
PURPLEAIR_API_KEY=your_key_here

# Sensör ID (GTÜ #229263, değiştirmeyin)
PURPLEAIR_SENSOR_ID=229263

# Veritabanı — boş bırakırsanız SQLite kullanılır (yerel geliştirme için ideal)
# PostgreSQL için: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# SQLite dosya yolu (DATABASE_URL boş olduğunda kullanılır)
SQLITE_PATH=campus_air.db

# Admin işlemleri için token (DELETE /api/sessions vb.)
ADMIN_TOKEN=changeme_please

# Polling aralığı (dakika)
POLL_INTERVAL_MINUTES=2

# CORS — frontend URL'si (üretimde GitHub Pages URL'nizi girin)
CORS_ORIGINS=*

# ───────────── CO₂ sensörü (Tuya Cloud) ─────────────
# iot.tuya.com → Cloud Project'ten alınır. Bölge: Central Europe.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Bölge sunucusu (Central Europe varsayılan). İzin hatası alırsanız sırayla deneyin:
#   https://openapi.tuyaeu.com  (Central Europe)  |  tuyawus.com  |  tuyaus.com
TUYA_API_ENDPOINT=https://openapi.tuyaeu.com

# Tek sensör için (hızlı başlangıç): cihaz ID + sabit konumu
TUYA_CO2_DEVICE_ID=
TUYA_CO2_NAME=CO2-1
TUYA_CO2_LOCATION=Kampüs
TUYA_CO2_LAT=40.806155
TUYA_CO2_LON=29.360985

# Çok sensör için (yukarıdaki tekli alanlar yerine) — JSON liste:
# TUYA_CO2_DEVICES=[{"name":"CO2-1","device_id":"abc","location":"SUMER Lab","lat":40.8061,"lon":29.3609},{"name":"CO2-2","device_id":"def","location":"Kütüphane","lat":40.8055,"lon":29.3615}]
